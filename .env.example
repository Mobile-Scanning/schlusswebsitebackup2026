# ---- SCHLUSS platform configuration (copy to .env; never commit .env) ----
NODE_ENV=production
APP_URL=https://schluss.co.za
# 48+ random characters, e.g.  openssl rand -base64 48
APP_SECRET=

# MySQL / MariaDB (from cPanel > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_MAX=5

# Sessions
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=14

# Outgoing email – the schluss.co.za mailboxes (SSL on port 465, login required).
# Main mailbox (support@): sends verification codes, customer emails, enquiries and alerts.
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="SCHLUSS <support@schluss.co.za>"
# Second mailbox (sales@): sends the business-partner emails. Leave empty to send everything from the main mailbox.
MAIL_SALES_USER=
MAIL_SALES_PASSWORD=
MAIL_SALES_FROM="SCHLUSS Sales <sales@schluss.co.za>"

# Where uploaded images/PDFs are stored (outside public_html). Default: ./storage
STORAGE_DIR=

# Team inbox(es) notified of demo requests, partner applications and enquiries (comma-separated)
ADMIN_NOTIFY_EMAIL=

# Department inboxes (defaults; can be changed later in Admin > Email settings)
SUPPORT_EMAIL=support@schluss.co.za
SALES_EMAIL=sales@schluss.co.za

# WhatsApp Business Platform (Cloud API). Optional here – you can enter these in Admin > WhatsApp settings
# instead (stored encrypted). Values set here override the admin screen.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Uploads: largest installer in MB, and malware scanning (ClamAV). Set MALWARE_SCAN=required to refuse
# uploads when no scanner is installed.
MAX_UPLOAD_MB=1024
MALWARE_SCAN=

# YouTube playlist imports (optional). Without a key a playlist import reads up to 15 videos (YouTube's public
# feed limit). With a free YouTube Data API v3 key (Google Cloud Console) whole playlists are imported, with
# durations and embedding checks. Server-side only – never put this key in frontend code.
YOUTUBE_API_KEY=

# Versions of legal documents users consent to
PRIVACY_POLICY_VERSION=2026-11
TERMS_VERSION=2026-11

# Test database (development only)
DB_NAME_TEST=schluss_test
