{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "schluss": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/manrope/latin-400.css",
              "node_modules/@fontsource/manrope/latin-500.css",
              "node_modules/@fontsource/manrope/latin-600.css",
              "node_modules/@fontsource/manrope/latin-700.css",
              "node_modules/@fontsource/space-grotesk/latin-500.css",
              "node_modules/@fontsource/space-grotesk/latin-600.css",
              "node_modules/@fontsource/space-grotesk/latin-700.css",
              "node_modules/@fontsource/jetbrains-mono/latin-500.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "schluss.co.za",
                "www.schluss.co.za",
                "localhost"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "externalDependencies": [
              "knex",
              "mysql2",
              "bcryptjs",
              "nodemailer",
              "dotenv",
              "helmet",
              "cookie-parser",
              "express-rate-limit",
              "zod",
              "express",
              "multer",
              "sharp"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "520kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "18kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "offline": {
              "browser": "src/main.offline.ts",
              "outputMode": "static",
              "ssr": false,
              "server": false,
              "prerender": false,
              "outputPath": "dist/offline",
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "extractLicenses": false,
              "budgets": []
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "schluss:build:production"
            },
            "development": {
              "buildTarget": "schluss:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}