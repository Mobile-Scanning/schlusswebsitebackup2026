{
  "name": "schluss-platform",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:schluss": "node dist/schluss/server/server.mjs",
    "start:prod": "node dist/schluss/server/server.mjs",
    "test:api": "vitest run --config vitest.server.config.ts",
    "test:all": "ng test --watch=false && vitest run --config vitest.server.config.ts",
    "db:migrate": "knex --knexfile server/db/knexfile.cjs migrate:latest",
    "db:rollback": "knex --knexfile server/db/knexfile.cjs migrate:rollback",
    "db:seed": "knex --knexfile server/db/knexfile.cjs seed:run",
    "admin:create": "node server/cli/create-admin.cjs",
    "worker": "node server/cli/worker.cjs",
    "mail:check": "node server/cli/mail-check.cjs",
    "backup": "node server/cli/backup.cjs",
    "restore": "node server/cli/restore.cjs",
    "live:check": "node server/cli/live-check.cjs",
    "build:offline": "ng build --configuration offline && node tools/make-offline.mjs",
    "offline:snapshot": "node tools/offline-snapshot.mjs",
    "setup": "node tools/setup.mjs",
    "db:fresh": "node tools/setup.mjs --fresh"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
