# ---- SCHLUSS – settings for the LIVE server (copy to .env on the server and fill in the three marked lines) ----
NODE_ENV=production
APP_URL=https://schluss.co.za
# FILL IN: a new random secret, different from the one on your computer. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# FILL IN: the MySQL / MariaDB database you created at your host
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sessions: customers are signed out after 12 hours without activity (14 days at most);
# admin (staff) sessions after 120 minutes without activity (24 hours at most).
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=14
SESSION_STAFF_IDLE_MINUTES=120
SESSION_STAFF_MAX_HOURS=24

# Automatic daily backup (database + uploaded files), verified after it is made. On by default on the live server.
# Put BACKUP_DIR outside the website folder, and copy it off the server regularly.
BACKUP_DAILY=on
BACKUP_DIR=
BACKUP_KEEP_DAYS=14

# Request ceiling per visitor address for the whole API (per 5 minutes)
API_RATE_LIMIT=1500

# Outgoing email – same as on your computer. FILL IN the two mailbox passwords.
MAIL_HOST=smtp.schluss.co.za
MAIL_PORT=465
MAIL_USER=support@schluss.co.za
MAIL_PASSWORD=
MAIL_FROM="SCHLUSS <support@schluss.co.za>"
MAIL_SALES_USER=sales@schluss.co.za
MAIL_SALES_PASSWORD=
MAIL_SALES_FROM="SCHLUSS Sales <sales@schluss.co.za>"

# Uploaded files. Best kept OUTSIDE the website folder so updates can never remove them, e.g. /home/youruser/schluss-storage
STORAGE_DIR=

ADMIN_NOTIFY_EMAIL=
SUPPORT_EMAIL=support@schluss.co.za
SALES_EMAIL=sales@schluss.co.za

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

MAX_UPLOAD_MB=1024
MALWARE_SCAN=
YOUTUBE_API_KEY=

PRIVACY_POLICY_VERSION=2026-11
TERMS_VERSION=2026-11
